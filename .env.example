# ─── SERVEUR ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=2026
HOST=0.0.0.0

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Runtime (app Fastify) → PgBouncer port 6543
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Migrations CLI (prisma migrate) → connexion directe port 5432
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ─── SUPABASE ─────────────────────────────────────────────────────────────────
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── CORS ─────────────────────────────────────────────────────────────────────
# En prod : liste des domaines autorisés séparés par des virgules
ALLOWED_ORIGINS="https://moneywise.app,https://app.moneywise.app"

# ─── IA — Providers (tous optionnels) ─────────────────────────────────────────
ANTHROPIC_API_KEY=""    # https://console.anthropic.com
GOOGLE_AI_API_KEY=""    # https://aistudio.google.com
GROQ_API_KEY=""         # https://console.groq.com  (gratuit)
XAI_API_KEY=""          # https://console.x.ai
OPENAI_API_KEY=""       # https://platform.openai.com

# ─── FIREBASE FCM (notifications push) ───────────────────────────────────────
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""   # Clé JSON, les \n doivent rester en \n
FIREBASE_CLIENT_EMAIL=""
